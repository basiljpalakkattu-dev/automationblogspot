<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowser">

    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="test.Basetest"/>
        </classes>
    </test>

    <test name="Edge">
